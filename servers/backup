#!/bin/sh
# Copies the server's own state off the box, nightly: the files no repository
# holds, because they are true of this machine only. `make backup` in this
# repository ships this file and the timer that runs it; runbooks/restore.md,
# "Get the server's own state back", is the way back.
#
# restic encrypts, deduplicates, and keeps the history. /etc/backup.env, mode
# 0400 and never in git, names the repository and its password, the storage
# credentials, and the dead man's switch's URL:
#
#     RESTIC_REPOSITORY=s3:https://<endpoint>/<bucket>
#     RESTIC_PASSWORD=…
#     AWS_ACCESS_KEY_ID=…
#     AWS_SECRET_ACCESS_KEY=…
#     PING_URL=https://hc-ping.com/<uuid>
#
# The application's data is not here. A database is copied by Litestream, or
# by the application's own snapshot, and runbooks/restore.md covers both.
set -u

set -a
. /etc/backup.env || exit 1
set +a

# Tells the dead man's switch, with the last lines of output as the body. A
# failure goes to /fail, so the alert says why.
report() { printf '%s\n' "$1" | tail -n 20 | curl -fsS -m 10 --retry 3 -o /dev/null --data-binary @- "$PING_URL$2" || true; }
failed() { printf '%s\n' "$1" >&2; report "$1" /fail; exit 1; }

# Portainer's database is one bolt file, and a copy taken while it writes may
# not open. It is stopped for the seconds the copy takes. Every other volume
# here is written rarely: Caddy's certificates, once in sixty days per site.
portainer_was_running=false
if [ "$(docker inspect -f '{{.State.Running}}' portainer-portainer-1 2> /dev/null)" = true ]; then
	portainer_was_running=true
	docker stop portainer-portainer-1 > /dev/null
fi

# What each one is, and what losing it costs: runbooks/restore.md, "Get the
# server's own state back". /opt holds every server-owned file — site files,
# secrets, site.env, litestream.yml, each .env — but not what a deploy writes
# again, and not the snapshots, which are the application's data.
out=$(restic backup --one-file-system --tag nightly \
	--exclude '/opt/*/src' --exclude '/opt/*/src.old' --exclude '/opt/*/src.new' \
	--exclude '/opt/*/incoming' --exclude '/opt/*/snapshots' --exclude '/opt/containerd' \
	/opt \
	/etc/systemd/network \
	/var/lib/docker/volumes/portainer_data \
	/var/lib/docker/volumes/caddy_caddy_data 2>&1)
status=$?

[ "$portainer_was_running" = false ] || docker start portainer-portainer-1 > /dev/null

[ "$status" -eq 0 ] || failed "$out"

# Seven nights, four weeks, six months. Pruning is the slow part, so it runs
# on Sundays only.
kept=$(restic forget --tag nightly --keep-daily 7 --keep-weekly 4 --keep-monthly 6 2>&1) || failed "$kept"
if [ "$(date +%u)" = 7 ]; then
	pruned=$(restic prune 2>&1) || failed "$pruned"
fi

report "$out" ""
