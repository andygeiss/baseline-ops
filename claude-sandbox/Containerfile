# The sandbox Claude Code runs in on the Mac you work on —
# runbooks/claude-sandbox.md. make claude-sandbox builds it. One image runs
# both containers of a session: the agent, and the proxy in front of it as
# nobody.

# Claude Code's npm package carries one native binary per platform, and npm is
# what picks the right one. Node is needed for that step alone, so it stays in
# this stage and never reaches the sandbox.
FROM docker.io/library/node:24-trixie-slim AS claude
ARG CLAUDE_CODE_VERSION=2.1.316
RUN npm install --global --no-audit --no-fund "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
 && cp "$(npm root --global)/@anthropic-ai/claude-code/bin/claude.exe" /claude

# egress is the proxy: HTTPS to public addresses, and nothing else
# (github.com/andygeiss/egress). go install checks the module against Go's
# checksum database, so a tag moved on GitHub cannot change what this pin
# builds, and it stamps the version egress -version prints. The flags build it
# the way egress's own make build does.
FROM docker.io/library/golang:1.27-trixie AS egress
ARG EGRESS_VERSION=v0.1.1
RUN CGO_ENABLED=0 go install -trimpath "github.com/andygeiss/egress@${EGRESS_VERSION}"

# statusline draws the line Claude Code shows under the prompt, the same one as
# on the Mac (github.com/andygeiss/statusline). Built like egress, for the same
# reasons.
FROM docker.io/library/golang:1.27-trixie AS statusline
ARG STATUSLINE_VERSION=v0.3.1
RUN CGO_ENABLED=0 go install -trimpath "github.com/andygeiss/statusline@${STATUSLINE_VERSION}"

# Debian, not alpine: the commands an agent writes assume GNU tools and glibc,
# not busybox and musl. The image already ships what make check needs beyond
# Go — gcc for go test -race, git, and make.
FROM docker.io/library/golang:1.27-trixie

# jq and ripgrep are for the agent's shell.
RUN apt-get update \
 && apt-get install --yes --no-install-recommends jq ripgrep \
 && rm -rf /var/lib/apt/lists/*

COPY --from=claude /claude /usr/local/bin/claude
COPY --from=egress /go/bin/egress /usr/local/bin/egress
COPY --from=statusline /go/bin/statusline /usr/local/bin/statusline

# Settings in ~/.claude live in each directory's volume, and an image change
# never reaches a volume that exists. Claude Code also reads
# /etc/claude-code/managed-settings.json, from the image, so every session gets
# the status line and starts on Opus 5.5, in old volumes and new. /model still
# switches the model for one session.
RUN mkdir /etc/claude-code \
 && printf '{"model":"claude-opus-5-5","statusLine":{"type":"command","command":"/usr/local/bin/statusline"}}\n' > /etc/claude-code/managed-settings.json

# uid 1000 is the one the launcher maps your Mac user to (--userns keep-id),
# so a file the agent writes in the project belongs to you on the Mac.
RUN useradd --create-home --uid 1000 --shell /bin/bash agent

# The root filesystem is read-only in the sandbox, so Go keeps its module and
# build caches in the home volume, not in the base image's /go. GOTOOLCHAIN
# stops go from downloading a newer toolchain than this image's.
#
# The Claude Code settings turn off what egress would let through: self-update
# (the image pins the version), telemetry, claude.ai connectors — they reach
# your mail and your files — and publishing pages to claude.ai.
ENV LANG=C.UTF-8 \
    GOPATH=/home/agent/go \
    GOTOOLCHAIN=local \
    PATH=/home/agent/go/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    ENABLE_CLAUDEAI_MCP_SERVERS=false \
    CLAUDE_CODE_DISABLE_ARTIFACT=1

USER agent
WORKDIR /home/agent
CMD ["claude"]
