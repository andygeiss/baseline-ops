#!/bin/sh
# claude-sandbox — run Claude Code in a rootless podman container that sees the
# directory it starts in, two skills read-only, and nothing else of the Mac.
# The directory must be ~/workspace or inside it. runbooks/claude-sandbox.md is
# the manual.
#
#   claude-sandbox [claude arguments]    claude-sandbox --continue, for one
#   claude-sandbox --shell [bash args]   a shell in the same sandbox, to look around
#
# make claude-sandbox installs this file and builds the image. Only the
# installed copy runs: the checkout lives in ~/workspace, where the agent can
# edit it, and a launcher the agent could edit would let it out next time.
set -eu

conn=podman-machine-default            # the machine's rootless connection
home=$HOME/.local/share/claude-sandbox # where make claude-sandbox copies the files
net=claude-sandbox                     # the agent's network, which has no way out

die() { printf 'claude-sandbox: %s\n' "$*" >&2; exit 1; }

# Every podman call goes to the machine's rootless side. --userns keep-id works
# only there, and this Mac's default connection is the rootful one.
podman() { command podman --connection "$conn" "$@"; }

# The directory the agent gets, with symlinks resolved, so a link cannot point
# the mount outside ~/workspace.
here=$(pwd -P)
root=$(cd "$HOME/workspace" && pwd -P) || die "there is no $HOME/workspace"
case $here/ in
"$root"/*) ;;
*) die "start me in $root or below it, not in $here" ;;
esac

[ -f "$home/Containerfile" ] || die "not installed — run make claude-sandbox in baseline-ops"
version=$(sed -n 's/^ARG CLAUDE_CODE_VERSION=//p' "$home/Containerfile")
image=localhost/claude-sandbox:$version
[ "$(podman info --format '{{.Host.Security.Rootless}}')" = true ] ||
	die "the connection $conn is not rootless"
podman image exists "$image" ||
	die "there is no image $image — run make claude-sandbox in baseline-ops"

cmd=claude
if [ "${1:-}" = --shell ]; then
	shift
	cmd=bash
fi

# The sign-in is a token from `claude setup-token`, kept in the login keychain.
# Claude does not start without one. A /login sign-in would live in one
# directory's volume, so each new directory would ask again, and claude -p
# cannot answer. A shell starts without a token.
if [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] &&
	token=$(security find-generic-password -s claude-sandbox -w 2> /dev/null); then
	export CLAUDE_CODE_OAUTH_TOKEN="$token"
fi
[ "$cmd" = bash ] || [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] ||
	die 'there is no sign-in token — make one on the Mac:
  claude setup-token
  security add-generic-password -U -a "$USER" -s claude-sandbox -w   # paste the token at the prompt'

# Internal means no gateway: the only thing the agent reaches on this network
# is the proxy. No DNS either, so it cannot carry data out in name lookups.
podman network exists "$net" ||
	podman network create --internal --disable-dns "$net" > /dev/null

# A launcher killed outright, by kill -9 or a tool's timeout, never stops its
# proxy, and egress runs until something does. So each start stops the proxies
# whose session is over: their launcher is gone, and their agent too. One whose
# agent still runs stays, or that agent would lose its only way out mid-task.
podman ps --filter name=claude-sandbox-proxy- --format '{{.Names}}' |
	while read -r old; do
		pid=${old##*-}
		case $pid in '' | *[!0-9]*) continue ;; esac
		kill -0 "$pid" 2> /dev/null && continue
		[ "$(podman container inspect --format '{{.State.Running}}' "claude-sandbox-$pid" 2> /dev/null)" = true ] && continue
		podman stop --time 0 "$old" > /dev/null 2>&1 || true
	done

# The proxy is egress, the agent's only way out. It sits on both networks, lets
# through HTTPS to public addresses and nothing else, and lives exactly as long
# as this session. egress listens on loopback by default. The agent reaches it
# over $net, so :8888 opens it on every address the proxy has.
proxy=claude-sandbox-proxy-$$
podman run --detach --rm --name "$proxy" \
	--network podman --network "$net" \
	--read-only --cap-drop all --security-opt no-new-privileges --user nobody \
	"$image" egress -listen :8888 > /dev/null

# On the way out, name what the proxy refused: a private address, a port other
# than 443, or plain HTTP. Nothing lets one of those through, so the list is
# for reading: a private address means something sent the agent toward the Mac
# or the LAN. Then stop the proxy.
finish() {
	refused=$(podman logs "$proxy" 2>&1 | sed -n 's/^egress: refuse //p' | sort | uniq -c)
	podman stop --time 0 "$proxy" > /dev/null 2>&1 || true
	[ -z "$refused" ] ||
		printf 'claude-sandbox: the proxy refused these — it lets through HTTPS to public addresses only:\n%s\n' "$refused" >&2
}
trap finish EXIT
trap 'exit 1' HUP INT TERM

ip=$(podman inspect --format "{{(index .NetworkSettings.Networks \"$net\").IPAddress}}" "$proxy")
url=http://$ip:8888

# Your git identity, so the agent's commits are yours, and it has no reason to
# write one into the project's .git/config.
if name=$(git config user.name) && email=$(git config user.email); then
	export GIT_AUTHOR_NAME="$name" GIT_AUTHOR_EMAIL="$email" \
		GIT_COMMITTER_NAME="$name" GIT_COMMITTER_EMAIL="$email"
fi

# The agent's home is a volume per directory: Claude's settings and sessions,
# and Go's caches, from one project never show up in another. The hash tells
# apart two directories with the same name.
name=$(printf %s "${here##*/}" | tr -c 'A-Za-z0-9_.-' -)
vol=claude-sandbox-$name-$(printf %s "$here" | shasum -a 256 | cut -c 1-8)

# The skills of the Claude Code you run on the Mac, each the checkout that the
# Mac's ~/.claude/skills links to. They are read-only here: the Claude outside
# the sandbox follows the same files, and an agent that could edit them could
# steer that Claude. The machine shares only ~/workspace, so a skill must live
# there.
set -- "$image" "$cmd" "$@"
for skill in engineering-baseline engineering-operations; do
	dir=$(cd "$HOME/.claude/skills/$skill" 2> /dev/null && pwd -P) || {
		printf 'claude-sandbox: no skill %s — run make install in its repository\n' "$skill" >&2
		continue
	}
	case $dir/ in
	"$root"/*) set -- --volume "$dir:/home/agent/.claude/skills/$skill:ro" "$@" ;;
	*) printf 'claude-sandbox: skill %s is in %s — the podman machine shares only %s\n' "$skill" "$dir" "$root" >&2 ;;
	esac
done

# Claude Code reads skills from ~/.claude/skills, in the home volume. podman
# would make a mount point's missing folders there as root, and then Claude
# could not write its own settings. So the agent makes them first.
#
# The same run marks Claude's first-run setup done in ~/.claude.json, and
# answers yes to Claude's question whether to trust this directory: you chose
# it by starting here. Without that, a new directory starts with a theme
# picker, a sign-in prompt the token makes pointless, and the trust question.
# The rest of the file stays as it is, and a file jq cannot read is left alone,
# for Claude to report.
podman run --rm --network none --userns keep-id:uid=1000,gid=1000 --user 1000:1000 \
	--cap-drop all --security-opt no-new-privileges --read-only \
	--volume "$vol:/home/agent" "$image" sh -c '
		mkdir -p ~/.claude/skills || exit 1
		umask 077
		f=~/.claude.json
		[ -s "$f" ] || echo "{}" > "$f"
		jq -e --arg dir "$1" ".hasCompletedOnboarding and .projects[\$dir].hasTrustDialogAccepted" "$f" > /dev/null 2>&1 && exit 0
		jq --arg dir "$1" ".hasCompletedOnboarding = true | .projects[\$dir].hasTrustDialogAccepted = true" "$f" > "$f.new" 2> /dev/null && mv "$f.new" "$f" || {
			rm -f "$f.new"
			echo "claude-sandbox: ~/.claude.json is not JSON, so Claude asks its first-run questions" >&2
		}
		exit 0' sh "$here"

# A terminal on both ends is a session you type into: it gets a terminal and
# your keys. Output into a pipe or a file gets neither: no terminal codes land
# in it, and claude -p does not wait three seconds for keys nobody types.
# Input from a pipe or a file always goes in.
interactive=true
tty=false
if [ -t 0 ]; then
	if [ -t 1 ]; then tty=true; else interactive=false; fi
fi

# The directory is mounted at the same path as on the Mac, so the paths in
# Claude's answers and in its per-project history are the Mac's paths.
# --detach-keys "" hands ctrl-p back to Claude Code. "$@" is the skills'
# mounts, then the image and the command.
podman run --rm --interactive="$interactive" --tty="$tty" --detach-keys "" --init \
	--name "claude-sandbox-$$" --hostname claude-sandbox \
	--network "$net" --dns none \
	--userns keep-id:uid=1000,gid=1000 --user 1000:1000 \
	--cap-drop all --security-opt no-new-privileges --read-only \
	--volume "$vol:/home/agent" \
	--volume "$here:$here" --workdir "$here" \
	--env HTTPS_PROXY="$url" --env https_proxy="$url" \
	--env HTTP_PROXY="$url" --env http_proxy="$url" \
	--env NO_PROXY=localhost,127.0.0.1 --env no_proxy=localhost,127.0.0.1 \
	--env TERM=xterm-256color --env COLORTERM \
	--env CLAUDE_CODE_OAUTH_TOKEN \
	--env GIT_AUTHOR_NAME --env GIT_AUTHOR_EMAIL \
	--env GIT_COMMITTER_NAME --env GIT_COMMITTER_EMAIL \
	"$@"
